# ---------------------------------------------------------------------------
# LIFE TRACE — environment configuration
# Copy to .env and fill in. NEVER commit a filled-in .env.
# All values are read server-side only; none are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public origin of the deployment (cookie 'secure' flag + origin checks)
APP_ORIGIN=http://localhost:3000
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- AI provider (ONE provider, server-side only) --------------------------
# Provider: openai (also works with any OpenAI-compatible endpoint)
AI_PROVIDER=openai
# Get a key at https://platform.openai.com/api-keys  (free tier available, see README)
OPENAI_API_KEY=
# Optional override for OpenAI-compatible gateways (Groq, OpenRouter, Together...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model id. gpt-4o-mini is the cheapest capable model on OpenAI.
OPENAI_MODEL=gpt-4o-mini
# Max output tokens per AI call (keeps cost predictable)
OPENAI_MAX_TOKENS=2500

# --- Database --------------------------------------------------------------
# DRIVER=json  -> file-backed local store (dev / single instance only)
# DRIVER=pg    -> PostgreSQL (Supabase or any managed Postgres) via DATABASE_URL
DRIVER=json
DATA_DIR=./.data
# Postgres connection string (required when DRIVER=pg)
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Trust a TLS-terminating proxy (Supabase pooler requires this)
PGSSLMODE=require

# --- External career data (free, no key required) --------------------------
# BLS Public Data API v2. Registration key optional; add for higher limits.
# Free key: https://data.bls.gov/registrationEngine/
BLS_API_KEY=
BLS_BASE_URL=https://api.bls.gov/publicAPI/v2/timeseries/data
# Wikipedia (MediaWiki) API for encyclopedia / learning-resource links
WIKI_API_URL=https://en.wikipedia.org/w/api.php
